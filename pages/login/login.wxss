/* pages/login/login.wxss */
.login-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #fff8f0 0%, #ffe4c4 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx 80rpx;
  box-sizing: border-box;
}

.login-header {
  text-align: center;
  margin-bottom: 120rpx;
}

.app-title {
  font-size: 96rpx;
  font-weight: bold;
  color: #d4884a;
  display: block;
  margin-bottom: 24rpx;
}

.app-subtitle {
  font-size: 56rpx;
  color: #8b6914;
}

.role-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

.role-option {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 80rpx 64rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  transition: all 0.2s;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.role-option:active {
  transform: scale(0.97);
  border-color: #d4884a;
}

.role-icon {
  font-size: 128rpx;
  display: block;
  margin-bottom: 32rpx;
}

.role-name {
  font-size: 72rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.role-desc {
  font-size: 52rpx;
  color: #999;
}

.customer-box {
  border-left: 16rpx solid #ffa940;
}

.merchant-box {
  border-left: 16rpx solid #d4884a;
}

.role-title {
  font-size: 64rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 60rpx;
}

.form-group {
  width: 100%;
  margin-bottom: 24rpx;
}

.password-input {
  width: 100%;
  height: 180rpx;
  border: 4rpx solid #ffcc80;
  border-radius: 24rpx;
  padding: 0 48rpx;
  font-size: 60rpx;
  box-sizing: border-box;
  background: #fff;
}

.error-msg {
  color: #e74c3c;
  font-size: 52rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.btn-group {
  display: flex;
  gap: 40rpx;
  margin-top: 40rpx;
}

.btn {
  flex: 1;
  height: 180rpx;
  line-height: 180rpx;
  border-radius: 24rpx;
  font-size: 64rpx;
  font-weight: bold;
  text-align: center;
  border: none;
  box-sizing: border-box;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-confirm {
  background: #d4884a;
  color: #fff;
}