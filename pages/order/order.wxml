<!-- 未提交时：确认下单界面 -->
<view wx:if="{{!orderSubmitted}}">
  <view class="cart-list">
    <view class="cart-item" wx:for="{{cart}}" wx:key="id">
    <!--   <image class="item-img" src="{{item.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>-->
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-price">¥{{item.price}} × {{item.quantity}}</text>
      </view>
    </view>
  </view>
  
  <view class="order-note">
    <input placeholder="备注（如：少辣）" value="{{note}}" bindinput="onInputNote" />
  </view>
  
  <view class="order-total">
    <text>总价：¥{{total}}</text>
  </view>
  
  <button class="submit-btn" bindtap="submitOrder">确认并下单</button>
</view>

<!-- 提交成功后：订单快照界面 -->
<view wx:else class="order-success">
  <text class="success-title">🎉 下单成功!</text>
  <view class="order-detail">
    <text class="detail-title">订单详情：</text>
    <view class="cart-item" wx:for="{{cart}}" wx:key="id">
    <!--  <image class="item-img" src="{{item.image}}" mode="aspectFill" binderror="onImageError" data-index="{{index}}"></image>-->
      <view class="item-info">
        <text class="item-name">{{item.name}}</text>
        <text class="item-price">¥{{item.price}} × {{item.quantity}}</text>
      </view>
    </view>
    <view class="order-note" wx:if="{{note}}">
      <text>备注：{{note}}</text>
    </view>
    <view class="order-total">
      <text>总价：¥{{total}}</text>
    </view>
    <text class="order-id" wx:if="{{orderId}}">订单编号：{{orderId}}</text>
  </view>
  <button class="back-btn" bindtap="goHome">返回首页</button>

<!-- 资料确认弹窗 -->
<view class="profile-modal" wx:if="{{showProfileModal}}">
  <view class="profile-mask" bindtap="closeProfileModal"></view>
  <view class="profile-content">
    <view class="profile-title">请确认您的资料</view>
    <view class="profile-desc">下单需要获取您的头像和昵称</view>
    
    <!-- 头像选择 -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="avatar-preview" src="{{userAvatar || defaultAvatar}}"></image>
      <text class="avatar-hint">点击选择头像</text>
    </button>
    
    <!-- 昵称输入 -->
    <input 
      class="nickname-input" 
      type="nickname" 
      placeholder="请输入昵称" 
      value="{{userNickname}}" 
      bindinput="onNicknameInput" 
    />
    
    <view class="profile-actions">
      <button class="profile-cancel" bindtap="closeProfileModal">取消</button>
      <button class="profile-confirm" bindtap="confirmProfile">确认并下单</button>
    </view>
  </view>
</view>








</view>