/* pages/merchant/merchant.wxss */

/* ========== 页面容器 ========== */
.merchant-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
  overflow: hidden;
}

/* ========== 第一行：标题栏 ========== */
.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #d4884a;
  flex-shrink: 0;
}
.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  white-space: nowrap;
}
.top-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  height: 56rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  white-space: nowrap;
  box-sizing: border-box;
}
.subscribe-btn {
  background: #ffa940;
  color: #fff;
}
.subscribed-text {
  font-size: 24rpx;
  color: #fff;
}
.logout-btn {
  color: #fff;
  border: 1rpx solid #fff;
  background: transparent;
}

/* ========== 第二行：统计栏 ========== */
.stats-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.stats-text {
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}
.stats-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.add-btn {
  background: #d4884a;
  color: #fff;
}
.fridge-btn {
  background: #1890ff;
  color: #fff;
}

/* ========== 第三行：标签切换 ========== */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #ff7d4d;
  font-weight: bold;
  border-bottom-color: #ff7d4d;
}

/* ========== 主体：左右分栏（同 menu 的 .main） ========== */
.content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类（同 menu 的 .left-menu） */
.left-col {
  width: 180rpx;
  background: #f1f1f1;
  overflow-y: auto;
  flex-shrink: 0;
}

.cat-item {
  padding: 24rpx 16rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.cat-item.active {
  background: #fff;
  color: #ff7d4d;
  font-weight: 700;
}

/* 右侧区域（同 menu 的 .right-area） */
.right-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  min-width: 0;
  min-height: 0;
}

/* 搜索框（同 menu） */
.search-bar {
  position: relative;
  padding: 12rpx 16rpx;
  background: #f7f7f7;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  height: 64rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 0 60rpx 0 24rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}

.search-clear {
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: #999;
  padding: 10rpx;
}

/* 菜品列表（同 menu） */
.dish-list {
  flex: 1;
  padding: 16rpx;
  overflow-y: auto;
}

.dish-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.dish-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.dish-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.dish-category {
  font-size: 24rpx;
  color: #666;
}

.dish-stock {
  font-size: 24rpx;
  color: #666;
}

.del-btn {
  flex-shrink: 0;
  align-self: center;
  background: #e74c3c;
  color: #fff;
  font-size: 24rpx;
  border-radius: 8rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

/* ========== 订单列表 ========== */
.order-list {
  flex: 1;
  min-height: 0;
  padding: 16rpx;
  box-sizing: border-box;
}

.order-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.order-id {
  font-size: 26rpx;
  color: #999;
}

.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.order-status.ok {
  background: #f6ffed;
  color: #389e0d;
}
.order-status.warn {
  background: #fff1f0;
  color: #cf1322;
}

.order-dishes {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.order-foot {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}
.order-time {
  color: #999;
}

/* ========== 空状态、加载中 ========== */
.empty-box,
.loading-box {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #bbb;
  display: block;
  margin-bottom: 24rpx;
}

.empty-btn {
  display: inline-block;
  background: #d4884a;
  color: #fff;
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

/* ========== 订单详情弹窗 ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}

.modal-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 999;
  box-sizing: border-box;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}

.detail-section {
  margin-bottom: 28rpx;
}

.detail-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.detail-dish {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}

.detail-total {
  font-size: 36rpx;
  color: #ff7d4d;
  font-weight: bold;
}

.compare-block {
  margin-bottom: 20rpx;
}

.compare-title {
  font-size: 26rpx;
  display: block;
  margin-bottom: 12rpx;
}
.compare-title.urgent { color: #cf1322; }
.compare-title.ok { color: #389e0d; }

.compare-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.compare-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.urgent-tag {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffa39e;
}
.ok-tag {
  background: #f6ffed;
  color: #389e0d;
  border: 1rpx solid #b7eb8f;
}

.modal-actions {
  display: flex;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  text-align: center;
}

.cancel-btn {
  background: #f5f5f5;
  color: #666;
}