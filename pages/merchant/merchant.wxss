/* pages/merchant/merchant.wxss */
.merchant-container {
  min-height: 100vh;
  background: #f7f7f7;
  padding-bottom: 40px;
}

.header {
  background: #d4884a;
  padding: 30px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 36px;
  font-weight: bold;
  color: #fff;
}

.logout-btn {
  font-size: 28px;
  color: #fff;
  padding: 8px 16px;
  border: 1px solid #fff;
  border-radius: 8px;
}

.stats-bar {
  background: #fff;
  padding: 20px 24px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1px solid #eee;
}

.stats-text {
  font-size: 28px;
  color: #666;
}

.add-btn {
  background: #d4884a !important;
  color: #fff !important;
  font-size: 26px !important;
  border-radius: 8px !important;
  height: 60px !important;
  line-height: 60px !important;
  padding: 0 24px !important;
}

.dish-list {
  padding: 16px;
}

.dish-item {
  background: #fff;
  border-radius: 12px;
  padding: 20px;
  margin-bottom: 16px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
}

.dish-img {
  width: 120px;
  height: 120px;
  border-radius: 8px;
  flex-shrink: 0;
  background: #f0f0f0;
}

.dish-info {
  flex: 1;
  margin-left: 20px;
  display: flex;
  flex-direction: column;
}

.dish-name {
  font-size: 30px;
  font-weight: bold;
  color: #333;
}

.dish-category {
  font-size: 24px;
  color: #999;
  margin-top: 6px;
}

.dish-stock {
  font-size: 24px;
  color: #666;
  margin-top: 4px;
}

.dish-actions {
  flex-shrink: 0;
  margin-left: 16px;
}

.del-btn {
  background: #e74c3c !important;
  color: #fff !important;
  font-size: 24px !important;
  border-radius: 8px !important;
  height: 56px !important;
  line-height: 56px !important;
  padding: 0 16px !important;
}

.loading-box {
  text-align: center;
  padding: 100px 0;
  font-size: 28px;
  color: #999;
}

.empty-box {
  text-align: center;
  padding: 120px 0;
}

.empty-text {
  font-size: 30px;
  color: #999;
  display: block;
  margin-bottom: 30px;
}

.empty-btn {
  background: #d4884a;
  color: #fff;
  width: 300px;
  border-radius: 12px;
  font-size: 30px;
}


.subscribe-bar {
  padding: 16px 24px;
  background: #fff;
  border-bottom: 1px solid #eee;
  text-align: center;
}
.subscribe-btn {
  background: #ffa940 !important;
  color: #fff !important;
  font-size: 26px !important;
  border-radius: 8px !important;
}
.subscribed-text {
  font-size: 26px;
  color: #52c41a;
}
/* 标签切换 */
.tab-bar {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  border-bottom: 4rpx solid transparent;
}
.tab-item.active {
  color: #ff7d4d;
  font-weight: bold;
  border-bottom-color: #ff7d4d;
}

/* 订单列表 */
.order-list {
  padding: 16rpx;
}
.order-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.order-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.order-id {
  font-size: 26rpx;
  color: #999;
}
.order-status {
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.order-status.ok {
  background: #f6ffed;
  color: #389e0d;
}
.order-status.warn {
  background: #fff1f0;
  color: #cf1322;
}
.order-dishes {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}
.order-foot {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}
.order-time {
  color: #999;
}

/* 订单详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}
.modal-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 640rpx;
  max-height: 80vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 999;
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}
.detail-section {
  margin-bottom: 28rpx;
}
.detail-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}
.detail-dish {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333;
  padding: 8rpx 0;
}
.detail-total {
  font-size: 36rpx;
  color: #ff7d4d;
  font-weight: bold;
}

/* 食材对比 */
.compare-block {
  margin-bottom: 20rpx;
}
.compare-title {
  font-size: 26rpx;
  display: block;
  margin-bottom: 12rpx;
}
.compare-title.urgent {
  color: #cf1322;
}
.compare-title.ok {
  color: #389e0d;
}
.compare-items {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.compare-tag {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.urgent-tag {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffa39e;
}
.ok-tag {
  background: #f6ffed;
  color: #389e0d;
  border: 1rpx solid #b7eb8f;
}

.modal-actions {
  display: flex;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}
.cancel-btn {
  background: #f5f5f5;
  color: #666;
}

/* 冰箱按钮 */
.fridge-btn {
  background: #1890ff !important;
  color: #fff !important;
  font-size: 26rpx !important;
  border-radius: 8px !important;
  height: 60rpx !important;
  line-height: 60rpx !important;
  padding: 0 24rpx !important;
  margin-left: 12rpx;
}