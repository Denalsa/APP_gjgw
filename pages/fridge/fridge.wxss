/* pages/fridge/fridge.wxss */
.fridge-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f7f7f7;
}

/* 顶部统计 */
.urgent-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: #fff2e8;
  border-bottom: 1rpx solid #ffd8bf;
}
.urgent-bar.safe {
  background: #f6ffed;
  border-bottom-color: #b7eb8f;
}
.urgent-icon, .safe-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.urgent-text {
  font-size: 28rpx;
  color: #d4380d;
  font-weight: bold;
}
.safe-text {
  font-size: 28rpx;
  color: #389e0d;
  font-weight: bold;
}

/* 主体分栏 */
.main-body {
  display: flex;
  flex: 1;
  overflow: hidden;
}

/* 左侧分类 */
.left-category {
  width: 200rpx;
  background: #f1f1f1;
}
.cat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: #666;
  border-bottom: 1rpx solid #e8e8e8;
}
.cat-item.active {
  background: #fff;
  color: #ff7d4d;
  font-weight: 700;
}
.cat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}
.cat-name {
  font-size: 24rpx;
}

/* 右侧食材列表 */
.right-ingredients {
  flex: 1;
  padding: 16rpx;
}

/* 新增按钮 */
.add-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx dashed #ff7d4d;
}
.add-icon {
  font-size: 36rpx;
  color: #ff7d4d;
  margin-right: 8rpx;
}
.add-text {
  font-size: 28rpx;
  color: #ff7d4d;
}

/* 食材卡片 */
.ingredient-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.ingredient-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.ingredient-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.tag-fresh {
  background: #f6ffed;
  color: #389e0d;
  border: 1rpx solid #b7eb8f;
}
.tag-normal {
  background: #fffbe6;
  color: #d48806;
  border: 1rpx solid #ffe58f;
}
.tag-urgent {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffa39e;
}

.ingredient-info {
  display: flex;
  gap: 24rpx;
  margin-bottom: 16rpx;
}
.info-text {
  font-size: 24rpx;
  color: #999;
}

.ingredient-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.action-btn {
  font-size: 24rpx !important;
  border-radius: 8rpx !important;
  padding: 0 24rpx !important;
}
.edit-btn {
  background: #fff7e6 !important;
  color: #d48806 !important;
  border: 1rpx solid #ffd591 !important;
}
.delete-btn {
  background: #fff1f0 !important;
  color: #cf1322 !important;
  border: 1rpx solid #ffa39e !important;
}

/* 空状态和加载 */
.empty-state, .loading-state {
  text-align: center;
  padding: 120rpx 0;
}
.empty-text {
  font-size: 28rpx;
  color: #bbb;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 998;
}
.modal-box {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  z-index: 999;
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 32rpx;
  color: #333;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 12rpx;
}
.form-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  background: #fafafa;
}
.picker-view {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  background: #fafafa;
  color: #333;
}
.picker-arrow {
  font-size: 36rpx;
  color: #999;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: none;
}
.cancel-btn {
  background: #f5f5f5;
  color: #666;
}
.confirm-btn {
  background: #ff7d4d;
  color: #fff;
}